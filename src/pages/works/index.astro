---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/PageTitle.astro';
import Panel from '@/components/Panel.astro';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);
---

<BaseLayout title="Works">
  <PageTitle>Works</PageTitle>
  <Panel as="section">
    <ul class="grid gap-5 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-12">
      {
        works.map((work) => (
          <li>
            <a href={`/works/${work.id}`} class="group block text-center hover:opacity-100">
              <div class="overflow-hidden rounded-md shadow-card">
                <Image
                  src={work.data.thumbnail}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <p class="mt-3 text-sm leading-relaxed">{work.data.title}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Panel>
</BaseLayout>
