---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import OriginalImage from '@/components/OriginalImage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/PageTitle.astro';
import Panel from '@/components/Panel.astro';

export const getStaticPaths = (async () => {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { work } = Astro.props;
const { title, url, tools, pc, sp } = work.data;
const { Content } = await render(work);
const caseNo = work.id.replace('case', 'Case ');
---

<BaseLayout title={`${title} | Works`}>
  <PageTitle>{caseNo}</PageTitle>
  <Panel as="article" class="space-y-10">
    <header class="space-y-1">
      <h2 class="text-lg font-normal">{title}</h2>
      <a href={url} target="_blank" rel="noopener" class="block break-all text-primary">{url}</a>
      <p class="font-en text-sm">{tools.join(' / ')}</p>
    </header>

    <div class="prose max-w-none prose-p:text-ink">
      <Content />
    </div>

    <div class="space-y-8">
      {
        pc.map((src, i) => (
          <OriginalImage
            src={src}
            alt={`${title} PC画面 ${i + 1}`}
            class="w-full rounded-md shadow-card"
          />
        ))
      }
    </div>

    <div class="grid grid-cols-3 gap-4 sm:gap-8">
      {
        sp.map((src, i) => (
          <OriginalImage
            src={src}
            alt={`${title} スマホ画面 ${i + 1}`}
            class="w-full rounded-md shadow-card"
          />
        ))
      }
    </div>

    <p class="text-center font-en">
      <a href="/works">← Back to Works</a>
    </p>
  </Panel>
</BaseLayout>
