---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/PageTitle.astro';
import Panel from '@/components/Panel.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import { Image } from 'astro:assets';

// プロフィール画像は GitHub のアイコンと連動（ビルド時に取得して WebP に最適化）。
// GitHub でアイコンを変えたら、次のデプロイで反映される
const AVATAR_URL = 'https://avatars.githubusercontent.com/u/74692740?s=460';

// 職歴（新しい順）。projects も新しい順
const career = [
  {
    company: 'テックタッチ株式会社',
    period: '2022.08 – 現在',
    type: '正社員 / Front-end Engineer',
    projects: [
      {
        period: '2023.09 –',
        title: '新規事業チーム：生成 AI プロダクト「Techtouch AI Hub」の開発',
        description:
          '立ち上げメンバーとして参画。市場調査・業務分析（インタビュー、ペルソナ・カスタマージャーニーマップ作成）・プロトタイプ作成から、UI / UX デザイン、フロントエンド開発（SPA・Chrome 拡張機能）、プロンプトエンジニアリングまでを一貫して担当。過去には顧客との PoC にもプロンプトエンジニアとして参画。',
        stack: ['React', 'TypeScript', 'Tailwind CSS', 'shadcn/ui', 'Redux Toolkit', 'Nx', 'Vite', 'Promptfoo', 'Figma', 'Illustrator'],
      },
      {
        period: '2022.08 –',
        title: 'プロダクトチーム：DAP「Techtouch」の開発',
        description:
          'Web システム上に操作ガイドやツールチップをノーコードで作成できる BtoB SaaS のフロントエンド開発（SPA・Chrome 拡張機能）を担当。フロントエンドチーム内の UI チームの一員として、デザインシステムの改修にも携わる。',
        stack: ['React', 'TypeScript', 'Material UI', 'styled-components', 'Redux Toolkit', 'Nx', 'Webpack', 'Jest', 'Vitest', 'Playwright', 'Biome', 'Figma'],
      },
    ],
  },
  {
    company: 'フリーランス',
    period: '2022.01 – 2022.07',
    type: '業務委託 / Front-end Engineer',
    projects: [
      {
        period: '2022.04 – 2024.05',
        title: '株式会社R（個人受注）：Jamstack 構成の Web サイト制作',
        description: '飲食店の空席状況をリアルタイムに確認できるサイトを、技術選定・UI / UX デザインから開発・公開・保守まで一人で担当。',
        stack: ['React', 'Next.js', 'TypeScript', 'SCSS', 'microCMS', 'Vercel'],
      },
      {
        period: '2022.04 – 2022.07',
        title: 'クラウドファンディングサービスサイトの改修',
        description: 'アニメ関連プロジェクトのクラウドファンディングサイトのフロントエンド開発。',
        stack: ['HTML', 'SCSS', 'JavaScript', 'Ruby on Rails'],
      },
      {
        period: '2022.01 – 2022.04',
        title: '学習管理システム（LMS）の開発・LP 制作',
        description: '法人向け SaaS 型 IT 人材育成サービスの Web アプリケーションとサービスサイトのフロントエンド開発。',
        stack: ['HTML', 'SCSS', 'JavaScript', 'Ruby on Rails', 'Docker'],
      },
    ],
  },
  {
    company: 'イートラスト株式会社',
    period: '2018.12 – 2021.12',
    type: '正社員 / Web Designer',
    projects: [
      {
        period: '2021.06 – 2021.12',
        title: '制作部チームリーダー',
        description:
          '8〜10 名規模の部署のリーダーとして、案件の進捗管理、デザインのクオリティ管理、CS 部署への技術サポート、新人メンバーの育成を担当。',
      },
      {
        period: '2018.12 – 2021.12',
        title: '中小企業向け Web サイト制作・DTP・動画制作',
        description:
          'Web サイトのデザイン・コーディングを中心に、DTP 制作、動画制作、ディレクションを担当。サイト公開後の保守・運用として、リモートでのカスタマーサポートにも従事。',
        stack: ['Photoshop', 'Illustrator', 'Premiere Pro', 'HTML', 'CSS', 'SCSS', 'JavaScript', 'jQuery', 'WordPress'],
      },
    ],
  },
];

const skills = [
  {
    label: 'Front-end',
    items: [
      'HTML / CSS / SCSS',
      'JavaScript',
      'TypeScript',
      'React',
      'Next.js',
      'Tailwind CSS',
      'Redux Toolkit',
      'Vite / Nx',
      'Jest / Vitest / Playwright',
      'Astro',
    ],
  },
  {
    label: 'Design',
    items: ['Figma', 'Photoshop', 'Illustrator', 'UI / UX デザイン', 'DTP'],
  },
  {
    label: 'AI',
    items: ['プロンプトエンジニアリング', 'Promptfoo', 'Claude Code'],
  },
  {
    label: 'CMS',
    items: ['WordPress', 'microCMS'],
  },
];

const certifications = ['色彩検定 UC級', 'HCD基礎検定', 'UX検定基礎'];

const links = [
  { label: 'GitHub', note: 'Code', href: 'https://github.com/smachiii' },
  { label: 'Zenn', note: 'Articles', href: 'https://zenn.dev/s_machino' },
  { label: 'YOUTRUST', note: 'Career', href: 'https://youtrust.jp/users/matchy' },
  { label: 'X', note: 'Posts', href: 'https://x.com/matchy_smachiii' },
];
---

<BaseLayout title="About">
  <PageTitle>About</PageTitle>
  <Panel as="section" class="space-y-12">
    <div>
      <div class="flex items-center gap-4 sm:gap-6">
        <Image
          src={AVATAR_URL}
          alt="Satomi Machino"
          width={88}
          height={88}
          densities={[1, 2]}
          loading="eager"
          class="size-16 shrink-0 rounded-full object-cover ring-1 ring-secondary sm:size-22"
        />
        <div>
          <p class="font-en text-xl leading-heading font-normal tracking-body sm:text-2xl">Satomi Machino</p>
          <p class="mt-1 font-en text-sm leading-heading text-primary sm:text-base">
            Front-end Engineer / UI Designer
          </p>
        </div>
      </div>
      <div class="mt-6 space-y-4">
        <p>Web 制作会社でのデザイン・コーディング、フリーランスでの Web アプリケーション開発を経て、現在はテックタッチ株式会社でフロントエンドエンジニアとして働いています。</p>
        <p>2023 年からは新規事業の立ち上げメンバーとして、市場調査から生成 AI プロダクトの UI / UX デザイン、フロントエンド開発、プロンプトエンジニアリングまで、職種の枠にとらわれず幅広く担当しています。</p>
        <p>日々の開発では Claude Code などの AI ツールを活用し、社内の AI 活用ワーキングチームで開発者向けの推進活動も行っています。</p>
        <p>個人での Web サイト制作・アプリケーション開発のご依頼も承っています。</p>
      </div>
    </div>

    <div>
      <SectionTitle>Career</SectionTitle>
      <ol class="space-y-14 border-l border-secondary">
        {
          career.map((job) => (
            <li class="relative pl-8">
              <span
                aria-hidden="true"
                class="absolute top-1.5 -left-1.5 size-3 rounded-full border-2 border-primary bg-surface"
              />
              <header class="space-y-1.5 leading-heading">
                <p class="font-en text-sm text-primary">{job.period}</p>
                <h3 class="text-lg font-normal tracking-body">{job.company}</h3>
                <p class="text-sm text-ink/60">{job.type}</p>
              </header>
              <ul class="mt-6 space-y-4">
                {job.projects.map((project) => (
                  <li class="rounded-md border border-muted bg-surface/50 px-5 py-4 sm:px-6 sm:py-5">
                    <p class="font-en text-xs leading-heading text-primary">{project.period}</p>
                    <h4 class="mt-1.5 font-normal">{project.title}</h4>
                    <p class="mt-2 text-ink/80">{project.description}</p>
                    {project.stack && (
                      <ul class="mt-3 flex flex-wrap gap-1.5">
                        {project.stack.map((tech) => (
                          <li class="rounded-xs bg-muted px-2 py-0.5 font-en text-xs leading-heading">{tech}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <SectionTitle>Skills</SectionTitle>
      <dl class="space-y-4">
        {
          skills.map((group) => (
            <div class="sm:flex sm:gap-6">
              <dt class="shrink-0 py-1 font-en text-sm leading-heading font-normal sm:w-28">{group.label}</dt>
              <dd>
                <ul class="mt-2 flex flex-wrap gap-2 sm:mt-0">
                  {group.items.map((skill) => (
                    <li class="rounded-xs bg-muted px-2.5 py-1 font-en text-sm leading-heading">{skill}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <SectionTitle>Certifications</SectionTitle>
      <ul class="list-inside list-disc">
        {certifications.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <div>
      <SectionTitle>Links</SectionTitle>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="group flex items-center justify-between gap-4 rounded-md border border-secondary bg-surface/60 px-5 py-3 hover:-translate-y-0.5 hover:border-primary hover:opacity-100 hover:shadow-card"
              >
                <span class="min-w-0">
                  <span class="block font-en text-lg leading-heading font-normal">{link.label}</span>
                  <span class="mt-0.5 block truncate text-xs leading-heading text-ink/60">{link.note}</span>
                </span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="size-5 shrink-0 text-primary transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Panel>
</BaseLayout>
