---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageTitle from '@/components/PageTitle.astro';
import Panel from '@/components/Panel.astro';
import SectionTitle from '@/components/SectionTitle.astro';
---

<BaseLayout title="About">
  <PageTitle>About</PageTitle>
  <Panel as="section" class="space-y-10">
    <div class="font-en font-normal">
      <SectionTitle>Profile</SectionTitle>
      <p>Name：Satomi Machino</p>
      <p>Job：Web Designer / Front-end Developer</p>
    </div>
    <div>
      <SectionTitle>Overview</SectionTitle>
      <p>
        フロントエンドエンジニア、Webデザイナーとして活動中。<br />
        デザインツール：Photoshop、Illustrator、Adobe XD、Figma<br />
        プログラミング言語：HTML、CSS（Sass）、JavaScript（React・jQuery）、Typescript<br />
        WordPressやmicroCMSなどにも対応しております。
      </p>
    </div>
    <div>
      <SectionTitle>Summary</SectionTitle>
      <p>
        Webデザイナー、コーダーとしてWeb制作会社に3年間在籍し、Webサイト制作に従事。<br />
        在籍時は部署のリーダーやディレクション、CS部署の技術サポートなども経験いたしました。<br />
        その後フリーランスに転向、業務委託のフロントエンドエンジニアとして、Webアプリケーションの開発に従事。<br />
        現在では、更なるスキルアップの為、自社開発企業に転職し、フロントエンドエンジニアとして日々奮闘しております。<br />
        現時点で担当した案件数は200件以上。Webアプリケーション開発やWebサイト制作など、個人での案件受託もしております。
      </p>
    </div>
  </Panel>
</BaseLayout>
