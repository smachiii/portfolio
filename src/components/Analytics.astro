---
// Google アナリティクス（GA4）。本番ビルドのときだけ読み込む。
// Search Console の所有権確認に使うため、Google 公式スニペットと同じ形のまま書く
// （define:vars などで加工すると確認ツールがタグを検出できなくなる）。
// 測定 ID を変える場合は下の2か所を書き換える。
const enabled = import.meta.env.PROD;
---

{
  enabled && (
    <Fragment>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WJ6W8LFK7H" />
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', 'G-WJ6W8LFK7H');
      </script>
    </Fragment>
  )
}
