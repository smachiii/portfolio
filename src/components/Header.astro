---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/works', label: 'Works' },
  { href: '/gallery', label: 'Gallery' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="flex h-bar items-center justify-center">
  <nav aria-label="メイン">
    <ul class="flex gap-6 sm:gap-8">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="relative font-en font-medium"
            >
              {label}
              {/* 下線は全ページで同じ transition:name を持つので、ページ遷移時に次の項目へスライドする */}
              {isActive(href) && (
                <span
                  transition:name="nav-indicator"
                  aria-hidden="true"
                  class="absolute inset-x-0 -bottom-1 h-px bg-current"
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
